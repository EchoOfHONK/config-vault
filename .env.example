# Generate actual .env and 0600 secret files with ./install.sh.
HTTP_PORT=8080
# Loopback by default. Explicitly set 0.0.0.0 for trusted-LAN direct HTTP access.
BIND_ADDRESS=127.0.0.1
DATA_DIRECTORY=./data
LOCAL_IMPORT_DIRECTORY=./imports
SECRETS_DIRECTORY=./.secrets
DOMAIN=
TZ=Europe/Moscow
# true only when the browser accesses Config Vault through HTTPS.
COOKIE_SECURE=false
